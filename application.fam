App(
    appid="bedjet_remote",
    name="BedJet Remote (experimental)",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="bedjet_remote_app",
    requires=["gui", "bt"],
    stack_size=3072,
    fap_category="Bluetooth",
    fap_version="0.1",
    fap_author="Fred de Ruiter",
    fap_description="Direct BLE remote for BedJet 3. Requires central-role firmware and Full BLE stack.",
    sources=[
        "bedjet_remote.c",
        "bedjet_protocol.c",
        "bedjet_controller.c",
        "bedjet_flipper.c",
        "bedjet_view.c",
    ],
)
