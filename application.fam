App(
    appid="bedjet_remote",
    name="FredJet (experimental)",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="bedjet_remote_app",
    targets=["f7"],
    requires=["gui", "bt"],
    stack_size=3072,
    fap_category="Bluetooth",
    fap_version="0.1",
    fap_author="Fred de Ruiter",
    fap_weburl="https://github.com/fderuiter/flipper_fredjet",
    fap_icon="bedjet_remote_10px.png",
    fap_description="Direct BLE remote compatible with BedJet 3. Requires central-role firmware and Full BLE stack.",
    sources=[
        "bedjet_remote.c",
        "bedjet_protocol.c",
        "bedjet_controller.c",
        "bedjet_flipper.c",
        "bedjet_view.c",
    ],
)
