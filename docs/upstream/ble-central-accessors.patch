diff --git a/targets/f7/ble_glue/furi_ble/central.h b/targets/f7/ble_glue/furi_ble/central.h
index f31930c..7a7135a 100644
--- a/targets/f7/ble_glue/furi_ble/central.h
+++ b/targets/f7/ble_glue/furi_ble/central.h
@@ -79,6 +79,43 @@ bool ble_central_is_scanning(void);
  * failure reason is the only useful diagnostic when scanning is refused. */
 uint8_t ble_central_last_status(void);
 
+/* Where the most recent connection or GATT client call failed.
+ *
+ * ble_central_last_status() only holds the synchronous result of the last ACI
+ * command. A call can also fail after the controller accepted that command: the
+ * wait times out, the procedure completes with an error, the peer answers with
+ * an ATT Error Response, or the link drops. Those leave last_status at 0. */
+typedef enum {
+    BleCentralErrorNone, /* the call succeeded, or none has run */
+    BleCentralErrorState, /* not connected, link unusable or busy; code is 0 */
+    BleCentralErrorCommand, /* the controller rejected the command; code is tBleStatus */
+    BleCentralErrorTimeout, /* no completion within timeout_ms; code is 0 */
+    BleCentralErrorProcedure, /* completion reported failure; code is its status */
+    BleCentralErrorAtt, /* the peer sent an ATT Error Response; code is the ATT error */
+    BleCentralErrorDisconnected, /* the link dropped during the call; code is the HCI reason */
+} BleCentralErrorSource;
+
+typedef struct {
+    BleCentralErrorSource source;
+    uint8_t code;
+    uint8_t att_request_opcode; /* the failed ATT request, for BleCentralErrorAtt */
+    uint16_t att_handle; /* the attribute the peer named, for BleCentralErrorAtt */
+} BleCentralError;
+
+/* Describes why the most recent connect, disconnect, discovery, enumeration,
+ * subscribe, read or write call returned false; read it only after a false
+ * return. Waits for any call in progress, so read it
+ * from the thread that made the call, after it returned. Scan calls do not
+ * change it. */
+void ble_central_last_error(BleCentralError* out);
+
+/* HCI reason from the most recent Disconnection Complete event on the central
+ * link: 0x08 supervision timeout, 0x13 peer terminated, 0x16 terminated by this
+ * side (including after a procedure timeout), and so on. 0 when the link has not
+ * dropped since the last successful connection. Unlike the error above, later
+ * calls do not clear it. */
+uint8_t ble_central_disconnect_reason(void);
+
 /* ---- connection / GATT client ----
  *
  * Every ACI procedure below is asynchronous and finishes with
@@ -105,6 +142,14 @@ bool ble_central_connect(
  * the central module rather than the peripheral GAP state machine. */
 bool ble_central_disconnect(void);
 bool ble_central_is_connected(void);
+
+/* True only while the link is connected and will admit GATT procedures. After a
+ * procedure timeout the link is marked unusable and termination is requested;
+ * if the controller refuses or has not yet confirmed termination,
+ * ble_central_is_connected() stays true while every GATT call fails. Callers
+ * should disconnect, or wait for disconnection, when this is false but
+ * ble_central_is_connected() is true. */
+bool ble_central_is_usable(void);
 uint16_t ble_central_connection_handle(void);
 
